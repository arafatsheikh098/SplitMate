# Copy to .env and adjust.
# All values shown are development defaults.

# Runtime
ENV=development
SECRET_KEY=change-me-in-production-at-least-32-bytes-random
APP_NAME=SplitMate
DEFAULT_LANGUAGE=en
SESSION_COOKIE_NAME=splitmate_session
SESSION_MAX_AGE=2592000

# Database
# For local SQLite:
DATABASE_URL=sqlite:///./splitmate.db
# For docker compose / Postgres:
# DATABASE_URL=postgresql+psycopg://splitmate:splitmate@db:5432/splitmate

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
