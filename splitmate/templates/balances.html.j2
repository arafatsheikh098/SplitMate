{% set t = t %}
{% set active_tab = "balances" %}
{% include "_group_nav.html.j2" %}

<section class="card card-elevated">
  <div class="card-header-row">
    <div>
      <h2 class="card-heading">{{ t("balance.title") }}</h2>
      <p class="muted">Net balance for each member computed directly from the immutable transaction ledger.</p>
    </div>
  </div>

  <div class="balances-grid">
    {% for pid, bal in balances.items() %}
      {% set m = members_by_id[pid] %}
      <div class="balance-card {% if bal > 0 %}balance-card-positive{% elif bal < 0 %}balance-card-negative{% else %}balance-card-settled{% endif %}">
        <div class="balance-card-header">
          <div class="avatar-circle avatar-color-{{ loop.index % 6 }}">
            {{ m.display_name[:1] | upper }}
          </div>
          <div>
            <strong class="balance-member-name">{{ m.display_name|e }}</strong>
            {% if current_member and m.id == current_member.id %}
              <span class="badge badge-neutral">You</span>
            {% endif %}
          </div>
        </div>

        <div class="balance-card-amount">
          {% if bal > 0 %}
            <div class="balance-figure text-positive">+{{ format_amount(bal, group.currency_symbol) }}</div>
            <div class="balance-status text-positive">{{ t("balance.owed", name="", amount="").strip() }}</div>
          {% elif bal < 0 %}
            <div class="balance-figure text-negative">-{{ format_amount(-bal, group.currency_symbol) }}</div>
            <div class="balance-status text-negative">{{ t("balance.owes", name="", amount="").strip() }}</div>
          {% else %}
            <div class="balance-figure text-muted">0.00 {{ group.currency_symbol }}</div>
            <div class="balance-status text-muted">Settled up</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section class="card card-elevated">
  <div class="card-header-row">
    <div>
      <h2 class="card-heading">{{ t("settle.title") }} — {{ t("settle.plan") }}</h2>
      <p class="muted">Minimum number of payments needed to completely square up all debts.</p>
    </div>
    <a class="btn btn-primary" href="/groups/{{ group.id }}/settle">
      <svg class="icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
        <line x1="2" y1="10" x2="22" y2="10"></line>
      </svg>
      {{ t("settle.record") }}
    </a>
  </div>

  {% if not plan %}
    <div class="empty-state">
      <div class="empty-icon">🎉</div>
      <h3>{{ t("balance.settled") }}</h3>
      <p class="muted">Everyone in {{ group.name }} is all square. No pending payments!</p>
    </div>
  {% else %}
    <div class="settle-plan-list">
      {% for (f, to, amt) in plan %}
        <div class="settle-plan-item">
          <div class="settle-transfer-flow">
            <div class="transfer-party transfer-from">
              <span class="avatar-circle-sm">{{ members_by_id[f].display_name[:1] | upper }}</span>
              <strong class="transfer-name">{{ members_by_id[f].display_name|e }}</strong>
              <span class="transfer-role text-negative">pays</span>
            </div>

            <div class="transfer-arrow-bridge">
              <span class="transfer-amount-pill">{{ format_amount(amt, group.currency_symbol) }}</span>
              <div class="transfer-line">
                <svg class="transfer-arrow-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>

            <div class="transfer-party transfer-to">
              <span class="avatar-circle-sm">{{ members_by_id[to].display_name[:1] | upper }}</span>
              <strong class="transfer-name">{{ members_by_id[to].display_name|e }}</strong>
              <span class="transfer-role text-positive">receives</span>
            </div>
          </div>

          <div class="settle-plan-action">
            <a class="btn btn-secondary btn-sm" href="/groups/{{ group.id }}/settle?from_id={{ f }}&to_id={{ to }}&amount={{ (amt / 100)|round(2) }}">
              Pay {{ format_amount(amt, group.currency_symbol) }} →
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>
