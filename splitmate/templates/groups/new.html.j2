{% set t = t %}
<div class="auth-card-wrapper">
  <section class="card card-elevated auth-card">
    <div class="auth-card-header">
      <div class="auth-icon-badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
      </div>
      <h1 class="auth-title">{{ t("group.create.title") }}</h1>
      <p class="muted">Create an expense ledger for your flat, trip, project, or household.</p>
    </div>

    {% if errors.form %}
      <div class="alert alert-danger" role="alert">
        <svg class="icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>{{ errors.form }}</span>
      </div>
    {% endif %}

    <form method="post" action="/groups/new" class="modern-form">
      <label class="form-group">
        <span class="form-label">{{ t("group.create.name_label") }} <span class="required">*</span></span>
        <input name="name" maxlength="100" required value="{{ values.name|e }}" placeholder="e.g. Goa Trip, Flat 4B, Roommates" class="input-modern" autofocus>
      </label>

      <label class="form-group">
        <span class="form-label">{{ t("group.create.currency_label") }} <span class="required">*</span></span>
        <input id="currency_input" name="currency_symbol" maxlength="8" required value="{{ values.currency_symbol|e }}" placeholder="৳, $, €, £, ₹" class="input-modern">
        <div class="currency-presets" role="group" aria-label="Currency presets">
          <span class="muted text-xs">Quick pick:</span>
          <button type="button" class="preset-pill" onclick="document.getElementById('currency_input').value='৳'">৳ BDT</button>
          <button type="button" class="preset-pill" onclick="document.getElementById('currency_input').value='$'">$ USD</button>
          <button type="button" class="preset-pill" onclick="document.getElementById('currency_input').value='€'">€ EUR</button>
          <button type="button" class="preset-pill" onclick="document.getElementById('currency_input').value='£'">£ GBP</button>
          <button type="button" class="preset-pill" onclick="document.getElementById('currency_input').value='₹'">₹ INR</button>
        </div>
      </label>

      <label class="form-group">
        <span class="form-label">{{ t("group.join.name_label") }} (Your name) <span class="required">*</span></span>
        <input name="admin_name" maxlength="60" required value="{{ values.admin_name|e }}" placeholder="e.g. Asha, Alex" class="input-modern">
      </label>

      <div class="form-actions-full">
        <button type="submit" class="btn btn-primary btn-lg btn-block">
          {{ t("group.create.submit") }} →
        </button>
        <a class="btn btn-secondary btn-block" href="/">Cancel</a>
      </div>
    </form>
  </section>
</div>