{% set t = t %}
<section class="card">
  <h1>Rejoin {{ group.name }}</h1>
  <p>Click the button to confirm.</p>
  <form method="post" action="/rejoin/{{ group.id }}/{{ code }}">
    {% if errors.form %}<p class="error">{{ errors.form }}</p>{% endif %}
    <button type="submit">Confirm rejoin</button>
  </form>
</section>