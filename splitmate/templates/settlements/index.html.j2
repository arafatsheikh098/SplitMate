<section class="card">
  <h1>{{ t("settle.title") }} — {{ group.name }}</h1>
  {% if errors.form %}<p class="error">{{ errors.form }}</p>{% endif %}
  <form method="post" action="/groups/{{ group.id }}/settle">
    <label>
      {{ t("settle.from") }}
      <select name="from_id" required>
        {% for m in members %}
          <option value="{{ m.id }}" {% if values.from_id == m.id|string %}selected{% endif %}>{{ m.display_name|e }}</option>
        {% endfor %}
      </select>
    </label>
    <label>
      {{ t("settle.to") }}
      <select name="to_id" required>
        {% for m in members %}
          <option value="{{ m.id }}" {% if values.to_id == m.id|string %}selected{% endif %}>{{ m.display_name|e }}</option>
        {% endfor %}
      </select>
    </label>
    <label>
      {{ t("settle.method") }}
      <select name="method">
        {% for m in methods %}
          <option value="{{ m }}" {% if values.method == m %}selected{% endif %}>{{ m }}</option>
        {% endfor %}
      </select>
    </label>
    <label>
      {{ t("settle.date") }}
      <input name="date_value" type="date" required value="{{ values.date|default(today) }}">
    </label>
    <label>
      amount
      <input name="amount" type="text" inputmode="decimal" required value="{{ values.amount|default('') }}">
    </label>
    <label>
      {{ t("settle.note") }}
      <input name="note" maxlength="300" value="{{ values.note|default('') }}">
    </label>
    <p>
      <button type="submit">{{ t("settle.submit") }}</button>
      <a class="secondary" href="/groups/{{ group.id }}/balances">cancel</a>
    </p>
  </form>
</section>

<section class="card">
  <h2>Settlements</h2>
  {% if not settlements %}
    <p class="muted">No settlements yet.</p>
  {% else %}
    <ul class="list">
      {% for s in settlements %}
        <li>
          <div>
            <strong>{{ format_amount(s.amount_minor, group.currency_symbol) }}</strong>
            <span class="muted">{{ s.method }} · {{ s.paid_on }}</span>
            {% if s.deleted_at %}<span class="badge warn">deleted</span>{% endif %}
          </div>
          {% if not s.deleted_at and (current_member.is_admin or s.creator_id == current_member.id) %}
          <form method="post" action="/groups/{{ group.id }}/settlements/{{ s.id }}/delete">
            <button class="secondary" type="submit">delete</button>
          </form>
          {% endif %}
          {% if s.deleted_at and current_member.is_admin %}
          <form method="post" action="/groups/{{ group.id }}/settlements/{{ s.id }}/restore">
            <button class="secondary" type="submit">restore</button>
          </form>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
